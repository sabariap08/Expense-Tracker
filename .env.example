# Copy this file to .env and replace every placeholder with your own values.
# Never commit the real .env file.

SECRET_KEY=replace_with_a_long_random_secret
MONGODB_URI=paste_your_mongodb_atlas_connection_string_here
MONGODB_DATABASE=expense_tracker
APP_USERNAME=enter_your_username_here
APP_PASSWORD_HASH='enter_your_password_hash_here'
FLASK_DEBUG=False

# Calendar timezone used for today's date and "current month" statistics.
# Examples: UTC, Asia/Kolkata, Europe/London, America/New_York
APP_TIMEZONE=UTC

# Keep True for HTTPS deployments. Set to False only for local http:// development.
SESSION_COOKIE_SECURE=True

# Session and CSRF token lifetime, in hours.
SESSION_LIFETIME_HOURS=12
